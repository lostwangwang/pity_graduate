{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Python Debugger: inference_bm25.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--experiment_name",
                "debug_correct",
                "--dataset_name",
                "2wikimultihopqa",
                "--input_path",
                "data/original/2wikimultihopqa_dev.csv",
                "--output_path",
                "predictions/debug_correct_predictions.csv",
                "--log_path",
                "logs/debug_correct_log.txt",
                "--start_index",
                "1",
                "--end_index",
                "2",
                "--batch_size",
                "1",
                "--max_turns",
                "4",
                "--top_docs",
                "6",
                "--remove_repeat_docs"
            ],
            "cwd": "${workspaceFolder}/S2G-RAG"
        },
    ]
}